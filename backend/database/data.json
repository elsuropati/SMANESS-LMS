  "lkpd": [
    {
      "id": "lkpd-1",
      "teacher_id": "usr-teacher-1",
      "title": "Prinsip Kimia Hijau dalam Kehidupan Sehari-hari",
      "subject": "Kimia",
      "grade": "X",
      "status": "published",
      "objectives": [
        "Mengidentifikasi 12 prinsip kimia hijau dalam aktivitas sehari-hari",
        "Menganalisis dampak reaksi kimia konvensional terhadap lingkungan",
        "Merancang solusi alternatif berbasis prinsip ramah lingkungan"
      ],
      "trigger_questions": "Mengapa industri modern kini beralih dari pelarut organik ke pelarut air?",
      "instructions": "Ikuti 6 langkah pengerjaan berurutan. Simpan kemajuan Anda secara berkala.",
      "material_text": "Kimia hijau adalah pendekatan kimia yang bertujuan mengurangi atau menghilangkan penggunaan bahan berbahaya.",
      "material_links": [],
      "activities": [
        {
          "id": "act-1",
          "title": "Identifikasi Prinsip Kimia Hijau",
          "instructions": "Identifikasikan 3 prinsip kimia hijau yang paling relevan dengan kehidupan sehari-hari Anda."
        }
      ],
      "questions": [
        {
          "id": "q-1",
          "type": "essay",
          "prompt": "Jelaskan bagaimana prinsip pencegahan limbah (Prinsip ke-1) dapat diterapkan dalam industri makanan!"
        },
        {
          "id": "q-2",
          "type": "essay",
          "prompt": "Berikan contoh konkret penggunaan pelarut yang lebih aman sebagai penerapan Prinsip ke-5 Kimia Hijau!"
        }
      ],
      "reflection_prompts": [
        "Apa yang paling menarik dari konsep kimia hijau menurut Anda?",
        "Bagaimana Anda dapat menerapkan prinsip kimia hijau dalam kehidupan sehari-hari?"
      ],
      "created_at": "2026-09-10T10:00:00Z"
    },
